{
  "info": {
    "_postman_id": "3f3be7c6-4f6e-4fc7-a2d9-8b6cc9c4f6d7",
    "name": "ShopSphere API - Security Lab",
    "description": "Complete Postman collection for the local-only ShopSphere e-commerce security misconfiguration lab. Run Authentication login requests first to capture JWTs. Vulnerable-only requests intentionally demonstrate OWASP A05 security misconfiguration behavior.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" }
  ],
  "item": [
    {
      "name": "Health",
      "description": "Unauthenticated service and database health checks.",
      "item": [
        {
          "name": "API root status",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/", "host": ["{{baseUrl}}"], "path": [""] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('returns a successful service status', function () {", "  pm.expect(pm.response.code).to.be.oneOf([200, 500]);", "});"] } }]
        },
        {
          "name": "Health check",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/health", "host": ["{{baseUrl}}"], "path": ["api", "health"] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('health endpoint returns 200', function () {", "  pm.response.to.have.status(200);", "});", "const body = pm.response.json();", "pm.expect(body.status).to.eql('ok');"] } }]
        }
      ]
    },
    {
      "name": "Authentication",
      "description": "Login requests save JWTs into environment variables for subsequent protected requests.",
      "item": [
        {
          "name": "Login - Customer",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('customer login succeeds', function () {", "  pm.response.to.have.status(200);", "});", "const body = pm.response.json();", "pm.expect(body.token).to.be.a('string');", "pm.environment.set('customerToken', body.token);", "pm.environment.set('customerId', String(body.user.id));"] } }]
        },
        {
          "name": "Login - Admin",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('admin login succeeds', function () {", "  pm.response.to.have.status(200);", "});", "const body = pm.response.json();", "pm.expect(body.token).to.be.a('string');", "pm.expect(body.user.role).to.eql('admin');", "pm.environment.set('adminToken', body.token);", "pm.environment.set('adminId', String(body.user.id));"] } }]
        },
        {
          "name": "Current customer profile",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }], "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('profile request succeeds', function () {", "  pm.response.to.have.status(200);", "});"] } }]
        }
      ]
    },
    {
      "name": "Products",
      "description": "Catalog reads. Products are publicly readable in both modes.",
      "item": [
        {
          "name": "List products",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/products?page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["api", "products"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "10" }] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('product list returns 200', function () {", "  pm.response.to.have.status(200);", "});", "pm.expect(pm.response.json().data).to.be.an('array');"] } }]
        },
        {
          "name": "Filter products by category",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/products?category=electronics&page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["api", "products"], "query": [{ "key": "category", "value": "electronics" }, { "key": "page", "value": "1" }, { "key": "limit", "value": "10" }] } }
        },
        {
          "name": "Get product by ID",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/products/{{productId}}", "host": ["{{baseUrl}}"], "path": ["api", "products", "{{productId}}"] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('product detail returns 200', function () {", "  pm.response.to.have.status(200);", "});"] } }]
        }
      ]
    },
    {
      "name": "Cart",
      "description": "Customer cart workflow. Adding an item decrements product stock, so reset the lab for repeatable runs.",
      "item": [
        {
          "name": "Get customer cart",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }], "url": { "raw": "{{baseUrl}}/api/cart", "host": ["{{baseUrl}}"], "path": ["api", "cart"] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('cart request returns 200', function () {", "  pm.response.to.have.status(200);", "});"] } }]
        },
        {
          "name": "Add product to customer cart",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"productId\": {{productId}},\n  \"quantity\": 1\n}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{baseUrl}}/api/cart", "host": ["{{baseUrl}}"], "path": ["api", "cart"] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('product is added to cart', function () {", "  pm.response.to.have.status(200);", "});"] } }]
        }
      ]
    },
    {
      "name": "Orders",
      "description": "Create and retrieve orders for the authenticated customer. Run Add product first before creating an order.",
      "item": [
        {
          "name": "List customer orders",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }], "url": { "raw": "{{baseUrl}}/api/orders", "host": ["{{baseUrl}}"], "path": ["api", "orders"] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('orders request returns 200', function () {", "  pm.response.to.have.status(200);", "});"] } }]
        },
        {
          "name": "Create order from cart",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{baseUrl}}/api/orders", "host": ["{{baseUrl}}"], "path": ["api", "orders"] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('order is created or cart is already empty', function () {", "  pm.expect(pm.response.code).to.be.oneOf([201, 400]);", "});", "if (pm.response.code === 201) {", "  pm.environment.set('orderId', String(pm.response.json().data.id));", "}"] } }]
        },
        {
          "name": "Get customer order by ID",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }], "url": { "raw": "{{baseUrl}}/api/orders/{{orderId}}", "host": ["{{baseUrl}}"], "path": ["api", "orders", "{{orderId}}"] } }
        }
      ]
    },
    {
      "name": "Admin",
      "description": "Admin-only endpoints. Use the admin login token. These requests should return 401/403 when the customer token is substituted.",
      "item": [
        {
          "name": "List users",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": { "raw": "{{baseUrl}}/api/admin/users", "host": ["{{baseUrl}}"], "path": ["api", "admin", "users"] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('admin users request succeeds', function () {", "  pm.response.to.have.status(200);", "});"] } }]
        },
        {
          "name": "List all orders",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": { "raw": "{{baseUrl}}/api/admin/orders", "host": ["{{baseUrl}}"], "path": ["api", "admin", "orders"] } }
        },
        {
          "name": "Get admin reports",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": { "raw": "{{baseUrl}}/api/admin/reports", "host": ["{{baseUrl}}"], "path": ["api", "admin", "reports"] } }
        },
        {
          "name": "Get storage permissions",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": { "raw": "{{baseUrl}}/api/admin/storage", "host": ["{{baseUrl}}"], "path": ["api", "admin", "storage"] } }
        }
      ]
    },
    {
      "name": "Storage",
      "description": "Storage permission checks. Vulnerable mode intentionally exposes private files without a token; hardened mode requires an admin token for private files.",
      "item": [
        {
          "name": "Read public file",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/storage/public/{{publicFile}}", "host": ["{{baseUrl}}"], "path": ["api", "storage", "public", "{{publicFile}}"] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('public file is readable', function () {", "  pm.response.to.have.status(200);", "});"] } }]
        },
        {
          "name": "Read private file - no token",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/storage/private/{{privateFile}}", "host": ["{{baseUrl}}"], "path": ["api", "storage", "private", "{{privateFile}}"] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('private file demonstrates mode-specific access', function () {", "  pm.expect(pm.response.code).to.be.oneOf([200, 401, 403]);", "});"] } }]
        },
        {
          "name": "Read private file - admin",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": { "raw": "{{baseUrl}}/api/storage/private/{{privateFile}}", "host": ["{{baseUrl}}"], "path": ["api", "storage", "private", "{{privateFile}}"] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('admin private storage request succeeds', function () {", "  pm.response.to.have.status(200);", "});"] } }]
        }
      ]
    },
    {
      "name": "Security Lab",
      "description": "Security misconfiguration demonstrations. Run only against the local lab. Debug requests are expected to return 404 in hardened mode.",
      "item": [
        {
          "name": "Debug configuration (SM-06)",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/debug/config", "host": ["{{baseUrl}}"], "path": ["api", "debug", "config"] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('debug endpoint demonstrates mode behavior', function () {", "  pm.expect(pm.response.code).to.be.oneOf([200, 404]);", "});"] } }]
        },
        {
          "name": "Debug health (SM-06)",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/debug/health", "host": ["{{baseUrl}}"], "path": ["api", "debug", "health"] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('debug health demonstrates mode behavior', function () {", "  pm.expect(pm.response.code).to.be.oneOf([200, 404]);", "});"] } }]
        },
        {
          "name": "Controlled error disclosure (SM-05)",
          "request": { "method": "GET", "header": [{ "key": "X-Request-ID", "value": "postman-lab-check" }], "url": { "raw": "{{baseUrl}}/api/lab/error", "host": ["{{baseUrl}}"], "path": ["api", "lab", "error"] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('controlled error returns HTTP 500', function () {", "  pm.response.to.have.status(500);", "});", "if (pm.response.headers.get('Content-Type') || '').includes('application/json')) {", "  const body = pm.response.json();", "  pm.test('error response has an error field', function () { pm.expect(body.error).to.be.a('string'); });", "}"] } }]
        },
        {
          "name": "Slow endpoint",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/lab/slow", "host": ["{{baseUrl}}"], "path": ["api", "lab", "slow"] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('slow endpoint is available only in vulnerable mode', function () {", "  pm.expect(pm.response.code).to.be.oneOf([200, 404]);", "});"] } }]
        },
        {
          "name": "OPTIONS products (SM-04)",
          "request": { "method": "OPTIONS", "header": [], "url": { "raw": "{{baseUrl}}/api/products", "host": ["{{baseUrl}}"], "path": ["api", "products"] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('OPTIONS response is captured for method exposure testing', function () {", "  pm.expect(pm.response.code).to.be.within(200, 499);", "});"] } }]
        },
        {
          "name": "TRACE products (SM-04)",
          "request": { "method": "TRACE", "header": [], "body": { "mode": "raw", "raw": "trace-check" }, "url": { "raw": "{{baseUrl}}/api/products", "host": ["{{baseUrl}}"], "path": ["api", "products"] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('TRACE response is captured for method exposure testing', function () {", "  pm.expect(pm.response.code).to.be.within(200, 599);", "});"] } }]
        },
        {
          "name": "CORS probe (SM-02)",
          "request": { "method": "GET", "header": [{ "key": "Origin", "value": "http://evil.example.local" }], "url": { "raw": "{{baseUrl}}/api/products", "host": ["{{baseUrl}}"], "path": ["api", "products"] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('CORS response is captured for comparison', function () {", "  pm.response.to.have.status(200);", "});", "console.log('Access-Control-Allow-Origin:', pm.response.headers.get('Access-Control-Allow-Origin')); "] } }]
        },
        {
          "name": "Security headers probe (SM-01/SM-09)",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/", "host": ["{{baseUrl}}"], "path": [""] }, "description": "Compare response headers in vulnerable and hardened modes. Inspect the Postman response Headers tab for CSP, HSTS, X-Content-Type-Options, X-Frame-Options, Referrer-Policy, and Server behavior." }
        }
      ]
    }
  ]
}
