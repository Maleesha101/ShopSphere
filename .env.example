# ShopSphere Security Lab - Environment Configuration
# Copy this file to .env and fill in values before running
# All values are synthetic/lab-only

# Application
PORT=8080
NODE_ENV=development
LAB_MODE=vulnerable

# Database
DATABASE_URL="postgresql://shopsphere:shopsphere-lab-password@postgres:5432/shopsphere"

# JWT
JWT_SECRET="shopsphere-lab-jwt-secret-change-me-in-hardened-mode"

# Redis (optional cache)
REDIS_URL="redis://redis:6379"

# Bcrypt
BCRYPT_SALT_ROUNDS=12
